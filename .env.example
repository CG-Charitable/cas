# Server
PORT=80
NODE_ENV=development
# The public-facing base URL of this auth server (used to build OAuth callback URLs)
AUTH_BASE_URL=http://localhost:80

# When true, a valid CAS session cookie lets a client skip the OAuth
# round-trip and get a token re-issued silently. Off by default.
SSO=false

# Google OAuth
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized redirect URIs: ${AUTH_BASE_URL}/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth
# Register app at: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
# Redirect URI: ${AUTH_BASE_URL}/auth/callback/microsoft
# Supported account types: "Accounts in any organizational directory and personal Microsoft accounts"
MS_CLIENT_ID=your-ms-app-client-id
MS_CLIENT_SECRET=your-ms-app-client-secret

# Email one-time-code login (/auth/email) — sent via tools/mail.js.
# Gmail (default): create an app password at https://myaccount.google.com/apppasswords
# Set EMAIL_TYPE=linux to use the local sendmail command instead.
# If neither is configured, development logs codes to the console and
# production disables email login.
EMAIL_TYPE=
GMAIL_USER=
GMAIL_PASS=
EMAIL_FROM="CAS <you@gmail.com>"
